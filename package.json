{
  "name": "lakebase-js",
  "version": "0.1.0",
  "description": "Lakebase JavaScript connection examples",
  "type": "module",
  "keywords": [
    "Databricks",
    "Lakebase",
    "Postgres",
    "pg",
    "node-postgres",
    "postgres.js",
    "Bun.SQL",
    "JavaScript",
    "TypeScript"
  ],
  "author": "George MacKerron",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "dotenv-expand": "^12.0.3",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.9",
    "kysely": "^0.28.11",
    "pg": "^8.18.0",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/deno": "^2.5.0",
    "@types/pg": "^8.16.0"
  },
  "scripts": {
    "postinstall": "pnpx prisma generate",
    "webapp-bun": "bun run src/webApp.js",
    "webapp-deno": "deno run --env-file=.env --allow-env --allow-net src/webApp.js",
    "webapp-node": "node -r dotenv-expand/config src/webApp.js",
    "bgtask-bun": "bun run src/backgroundTask.js",
    "bgtask-deno": "deno run --env-file=.env --allow-env --allow-net src/backgroundTask.js",
    "bgtask-node": "node -r dotenv-expand/config src/backgroundTask.js",
    "oneshot-bun": "bun run src/oneShotScript.js",
    "oneshot-deno": "deno run --env-file=.env --allow-env --allow-net src/oneShotScript.js",
    "oneshot-node": "node -r dotenv-expand/config src/oneShotScript.js"
  }
}
